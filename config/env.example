# Copy this file to the project root as .env. Never commit real credentials.
# Add one object per account. Optional fields: password, totpSecret,
# recoveryEmail, region, and proxy (proxyHttp, url, port, username, password).
ACCOUNTS_JSON='[
	{
		"email": "email@example.com"
	}
]'

# Optional local Control API
# See scripts/api/README.md for full documentation.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#API_TOKEN=